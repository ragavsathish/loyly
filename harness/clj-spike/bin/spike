#!/usr/bin/env bash
# Wrapper: harness/clj-spike/bin/spike <task> [args...]
# Runs with this folder's bb.edn (:deps / :paths). Default --root is the repo.
set -euo pipefail
SPIKE="$(cd "$(dirname "$0")/.." && pwd)"
REPO="$(cd "$SPIKE/../.." && pwd)"
if [[ $# -lt 1 ]]; then
  echo "usage: harness/clj-spike/bin/spike <gen-checklist|score|scoreboard|stamp|demo|lint|analyze> [args...]" >&2
  exit 2
fi
task="$1"; shift
case "$task" in
  lint|analyze|analyze:deps|analyze:dead|analyze:dupes|analyze:metrics|lint:kondo|lint:loyly)
    cd "$SPIKE"
    exec bb scripts/analyze.clj "$task" "$@"
    ;;
esac
case "$task" in
  gen-checklist|gen_checklist) ns=loyly.spike.gen-checklist ;;
  score) ns=loyly.spike.score ;;
  scoreboard) ns=loyly.spike.scoreboard ;;
  stamp) ns=loyly.spike.stamp-item-ids ;;
  demo) ns=loyly.spike.demo ;;
  *)
    echo "unknown task: $task" >&2
    exit 2
    ;;
esac
# bb.edn lives in $SPIKE; default the working tree to the git repo root.
has_root=0
for a in "$@"; do
  if [[ "$a" == "--root" ]]; then has_root=1; break; fi
done
cd "$SPIKE"
if [[ $has_root -eq 0 ]]; then
  exec bb -m "$ns" --root "$REPO" "$@"
else
  exec bb -m "$ns" "$@"
fi
