{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pinned Pi live cycle",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "run_id", "controller_commit", "source", "scratch", "builder", "grader"],
  "properties": {
    "schema": { "enum": ["loyly.pi-live-run.v1", "harness.pi-live-run.v2"] },
    "project": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "runtime": { "type": "object", "additionalProperties": false,
      "properties": { "java21": { "type": "boolean" } } },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "score_cycle": { "type": "string", "pattern": "^[0-9]{2}$" },
    "controller_commit": { "$ref": "#/$defs/commit" },
    "source": { "type": "object", "additionalProperties": false,
      "required": ["repo", "commit", "checklist_sha256"],
      "oneOf": [
        { "required": ["spec_file", "spec_sha256"], "not": { "required": ["specs"] } },
        { "required": ["specs"], "not": { "anyOf": [
          { "required": ["spec_file"] }, { "required": ["spec_sha256"] } ] } }
      ],
      "properties": { "repo": { "type": "string", "minLength": 1 },
        "commit": { "$ref": "#/$defs/commit" }, "checklist_sha256": { "$ref": "#/$defs/sha" },
        "spec_file": { "type": "string", "minLength": 1 }, "spec_sha256": { "$ref": "#/$defs/sha" },
        "specs": { "type": "array", "minItems": 1, "items": { "type": "object",
          "additionalProperties": false, "required": ["file", "sha256"],
          "properties": { "file": { "type": "string", "minLength": 1 },
            "sha256": { "$ref": "#/$defs/sha" } } } } } },
    "scratch": { "type": "string", "minLength": 1 },
    "builder": { "$ref": "#/$defs/agent" },
    "grader": { "allOf": [{ "$ref": "#/$defs/agent" }, { "type": "object",
      "required": ["settings", "settings_sha256", "schema_sha256", "shards"],
      "properties": { "schema_sha256": { "$ref": "#/$defs/sha" },
        "shards": { "type": "integer", "minimum": 1, "maximum": 16 } } }] },
    "blind": { "allOf": [{ "$ref": "#/$defs/agent" }, { "type": "object",
      "required": ["settings", "settings_sha256"] }] },
    "panel": { "type": "object", "additionalProperties": false,
      "required": ["image", "image_sha256", "plan_sha256"],
      "properties": { "image": { "type": "string", "minLength": 1 },
        "plan_file": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.panel\\.json$" },
        "image_sha256": { "$ref": "#/$defs/sha" }, "plan_sha256": { "$ref": "#/$defs/sha" } } }
  },
  "allOf": [{ "if": { "properties": { "schema": { "const": "loyly.pi-live-run.v1" } } },
    "then": { "required": ["blind", "panel"], "not": { "required": ["project"] } },
    "else": { "required": ["project"], "not": { "required": ["blind"] } } }],
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "agent": { "type": "object", "additionalProperties": false,
      "required": ["command", "command_sha256", "image", "image_sha256", "model", "instruction_sha256"],
      "properties": { "command": { "type": "string", "minLength": 1 },
        "command_sha256": { "$ref": "#/$defs/sha" },
        "image": { "type": "string", "minLength": 1 },
        "image_sha256": { "$ref": "#/$defs/sha" },
        "model": { "type": "string", "minLength": 1 },
        "instruction_sha256": { "$ref": "#/$defs/sha" },
        "instruction_file": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.md$" },
        "settings": { "type": "string", "minLength": 1 },
        "settings_sha256": { "$ref": "#/$defs/sha" },
        "schema_sha256": { "$ref": "#/$defs/sha" },
        "shards": { "type": "integer", "minimum": 1, "maximum": 16 } }
    }
  }
}
