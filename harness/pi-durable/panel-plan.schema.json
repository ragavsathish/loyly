{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loyly.example/schema/grading-panel-plan.v1.json",
  "title": "Löyly grading panel plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project", "feature", "checks"],
  "properties": {
    "schema": { "enum": ["loyly.grading-panel-plan.v1", "harness.grading-panel-plan.v2"] },
    "project": { "type": "string", "minLength": 1 },
    "bundle": { "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^[a-z][a-z0-9/-]*$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      } },
    "feature": { "type": "string", "minLength": 1 },
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "source", "role", "tool", "technique", "items", "criterion", "failure", "target_runtime"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "source": { "enum": ["raw-grader", "blind-review", "specialist"] },
          "role": { "enum": ["scored", "handoff", "corroborating", "diagnostic"] },
          "tool": { "type": "string", "minLength": 1 },
          "script": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.mjs$" },
          "feature": { "type": "string", "minLength": 1 },
          "probe": { "type": "object", "additionalProperties": false,
            "required": ["method", "path", "expected_status"],
            "properties": {
              "method": { "enum": ["GET", "POST", "PUT", "DELETE"] },
              "path": { "type": "string", "pattern": "^/[A-Za-z0-9/?=&._-]*$" },
              "expected_status": { "type": "integer", "minimum": 100, "maximum": 599 },
              "json_body": { "type": "object" }
            } },
          "technique": { "type": "string", "minLength": 1 },
          "items": { "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[0-9]{2}-[0-9]{3}$" } },
          "criterion": { "type": "string", "minLength": 1 },
          "failure": { "type": "string", "minLength": 1 },
          "target_runtime": { "const": "gondolin-qemu-vm" }
        }
      }
    }
  },
  "allOf": [{ "if": { "properties": { "schema": { "const": "harness.grading-panel-plan.v2" } } },
    "then": { "required": ["bundle"], "properties": { "checks": { "items": {
      "if": { "properties": { "source": { "const": "specialist" } } },
      "then": { "required": ["script"] }
    } } } } }]
}
