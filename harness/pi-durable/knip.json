{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "worker.mjs!",
    "demo.mjs!",
    "export.mjs!",
    "run-live.mjs!",
    "reassess-panel.mjs!",
    "blind-review-cli.mjs!",
    "correct-blind-route.mjs!",
    "recover-blind-score.mjs!",
    "render-allure.mjs!",
    "supplemental-grade.mjs!",
    "tasks/*.ts!",
    "test/**/*.test.mjs!"
  ],
  "project": ["**/*.{ts,mjs,js}"],
  "ignore": [
    "fixture/**",
    "test/fixtures/**",
    "scratch*/**",
    "reviews/**",
    "node_modules/**",
    "example-replay.html",
    "allurerc.mjs",
    "panel-browser.mjs",
    "panel-protocol.mjs",
    "panel-telemetry.mjs",
    "panel-runtime.mjs",
    "panel-otel-instrumentation.mjs",
    "grading-room.mjs",
    "score-receipt.mjs",
    "gate-adapter.mjs",
    "grader-shards.mjs",
    "panel-selection.mjs",
    "audit-rows.mjs",
    "allure-results.mjs",
    "replay-evidence.mjs",
    "panel-adapter.mjs",
    "builder-adapter.mjs",
    "blind-review.mjs",
    "panel-compile.mjs",
    "panel-vm-run.mjs"
  ],
  "ignoreBinaries": ["cmp"],
  "ignoreDependencies": [
    "allure",
    "@opentelemetry/api",
    "@opentelemetry/exporter-metrics-otlp-http",
    "@opentelemetry/exporter-trace-otlp-http",
    "@opentelemetry/instrumentation",
    "@opentelemetry/instrumentation-http",
    "@opentelemetry/resources",
    "@opentelemetry/sdk-metrics",
    "@opentelemetry/sdk-node",
    "playwright-core"
  ],
  "ignoreExportsUsedInFile": true
}
